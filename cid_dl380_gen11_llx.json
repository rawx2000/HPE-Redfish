 "bios_rules": [
  {
   "label": "PCIe bifurcation (all slots)",
   "regex": "^PciSlot\\d+Bifurcation$",
   "except": {},
   "value": "NoBifurcation"
  },
  {
   "label": "PCIe MCTP broadcast (all slots)",
   "regex": "^Slot\\d+MctpBroadcastSupport$",
   "except": {},
   "value": "Enabled"
  },
  {
   "label": "PCIe EOI broadcast (all slots)",
   "regex": "^Slot\\d+EoiBroadcastSupport$",
   "except": {},
   "value": "Disabled"
  },
  {
   "label": "PCIe Slot Network Boot (all NIC ports except Slot 1 Port 1)",
   "regex": "^Slot\\d+NicBoot\\d+$",
   "except": {
    "Slot1NicBoot1": "Network Boot"
   },
   "value": "Disabled"
  }
 ],
 "boot_order": [
  {
   "name": "Generic USB Boot",
   "match": [
    "usb"
   ]
  },
  {
   "name": "Slot 1 Port 1 Solarflare NIC (PXE IPv4)",
   "match": [
    "solarflare",
    "port 1",
    "ipv4"
   ]
  },
  {
   "name": "Slot 2 HPE SR932i-p Gen11 RAID1 Logical Drive 1",
   "match": [
    "sr932i",
    "slot 2"
   ]
  }
 ],
 "system": [
  {
   "name": "Secure Boot disabled",
   "resources": [
    "secure_boot"
   ],
   "body": {
    "SecureBootEnable": false
   }
  }
 ],
 "ilo": [
  {
   "name": "Network protocols and ports",
