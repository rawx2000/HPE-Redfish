     "Port": 80
    },
    "HTTPS": {
     "Port": 443
    },
    "VirtualMedia": {
     "ProtocolEnabled": true,
     "Port": 17988
    },
    "KVMIP": {
     "ProtocolEnabled": true,
     "Port": 17990
    }
   }
  },
  {
   "name": "SNTP time servers",
   "resources": [
    "datetime"
   ],
